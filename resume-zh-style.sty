\newcommand{\schooltag}[1]{%
  \tcbox[
    on line,
    boxsep=1.2pt,
    left=2pt,
    right=2pt,
    top=1pt,
    bottom=1pt,
    colback=cyan!12,
    colframe=cyan!12,
    arc=2pt,
    boxrule=0pt
  ]{\textcolor{cyan!80}{\sffamily\normalsize #1}}\hspace{4pt}%
}

% Avoid hyperref bookmark warnings when \schooltag appears in section titles.
\pdfstringdefDisableCommands{%
  \def\schooltag#1{}%
  \def\quad{ }%
}

% 收紧 section 标题的上下间距（resume.cls 默认为 *1.8/*1.8），使全文控制在一页内。
% *n 的单位为 1ex（titlesec 的 \beforetitleunit / \aftertitleunit）。
\titlespacing*{\section}{0cm}{*1.2}{*1.0}

