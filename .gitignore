# Copy this file to the Git repository and rename it ".gitignore".
# Lines starting with '#' are treated as comments.

############################################
## USER SCRIPTS AND NOTES
############################################

/*.bat
/\!*
.DS_Store
*.pdf
!releases/**/*.pdf

# 编译和视觉检查产物
/build/
/tmp/

# 完整源码备份体积较大，仅在本地保留；Git 通过标签保存同一版本。
/releases/**/*.zip

############################################
## LATEX TEMPORARY FILES
############################################

*.log
*.aux
*.bbl
*.blg
*.tex.undo
*.tex.bak
*.~te
*.$te
*.DVX
*.DDF
*.synctex.gz
*.synctex.gz(busy)
*.fdb_latexmk
*.fls
*.out
*.toc
*.lof
*.lot
*.idx
*.ilg
*.ind

*.dvi
*.ps

############################################
# do not upload secret infomation
myresume.tex
myresume.pdf
myresume-zh_CN.tex
myresume-zh_CN.pdf
